<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Button?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.javaproject.DemineurController"
      prefHeight="600.0" prefWidth="800.0"
      style="-fx-background-color: #2c3e50;">

    <Label text="Étape 4 : Localisation de la bombe"
           style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>

    <Label text="Trouvez les indices sans faire exploser la ville !"
           style="-fx-text-fill: #ecf0f1;"/>

    <GridPane fx:id="grilleDemineur" alignment="CENTER" hgap="5" vgap="5">
    </GridPane>

    <Button text="Quitter et Sauvegarder" onAction="#handleSaveAndQuit"/>
</VBox>

